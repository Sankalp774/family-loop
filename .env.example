# Family Loop — copy to .env

# scripted / mock = deterministic Strands loop (video-safe, no GPU)
# lmstudio        = live local model from LM Studio (OpenAI-compatible at :1234)
# bedrock         = Amazon Bedrock Claude Sonnet (hackathon submission)
FAMILY_LOOP_MODEL=scripted

# LM Studio — start the app, load a model, enable the local server
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_MODEL=
# LMSTUDIO_API_KEY=lm-studio

# Required when FAMILY_LOOP_MODEL=bedrock
AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_BEARER_TOKEN_BEDROCK=

# Default is Claude Sonnet 4.6 via Bedrock. Override if your account uses another id.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Optional: persist the JSON store somewhere else
# FAMILY_LOOP_DATA=./data/family.json

# Demo clock stays in the JSON store; leave unset for wall clock.
# FAMILY_LOOP_TZ=Asia/Kolkata
