# Family Loop — copy to .env

# mock  = Strands Agent loop with a local router model (no AWS bill, tools still run)
# bedrock = Amazon Bedrock Claude Sonnet (use this for the hackathon submission)
FAMILY_LOOP_MODEL=mock

# Required when FAMILY_LOOP_MODEL=bedrock
AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_BEARER_TOKEN_BEDROCK=

# Default is Claude Sonnet 4.6 via Bedrock. Override if your account uses another id.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Optional: persist the JSON store somewhere else
# FAMILY_LOOP_DATA=./data/family.json

# Demo clock stays in the JSON store; leave unset for wall clock.
# FAMILY_LOOP_TZ=Asia/Kolkata
